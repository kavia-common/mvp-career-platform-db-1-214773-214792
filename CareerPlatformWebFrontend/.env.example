# Optional environment variables for Create React App builds.
# Not required for Docker/CI builds. Values must be prefixed with REACT_APP_.

# Base URL for the backend API (defaults to /api/v1 if not provided)
REACT_APP_API_BASE_URL=https://api.example.com/api/v1

# Environment label (defaults to "development" if not provided)
REACT_APP_ENV=production
