# Example environment variables for the Career Platform Web Frontend (Create React App)
# Copy to .env and adjust values if you want to customize behavior locally.
# These are optional; the app builds and runs with sensible defaults even if not set.

# Base URL for backend API. Default (if not provided) should be served via the same host with a reverse proxy at /api/v1.
# Example: http://localhost:8000/api/v1
REACT_APP_API_BASE_URL=/api/v1

# Environment name: development, staging, production
REACT_APP_ENV=development

# Optional feature flags (examples)
# REACT_APP_FEATURE_SOME_FLAG=true
